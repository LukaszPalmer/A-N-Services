# Öffentliche Basis-URL (für Canonical-Links, Sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.services-an.de

# Kontaktformular – Versand über das IONOS-Postfach (SMTP, siehe src/lib/mail.ts)
# Passwort NIE hier eintragen (Repo ist öffentlich): lokal in .env.local,
# live in Vercel → Settings → Environment Variables.
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_USER=kontakt@services-an.de
SMTP_PASSWORD=
